# ─────────────────────────────────────────────────────────────────────────────
# AI-SaMD Clinical Protocol Copilot — environment template
# Copy to .env and edit. Nothing here is required for the unit tests.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider ─────────────────────────────────────────────────────────────
# "local"     → any OpenAI-compatible server on the GB10 (vLLM / Ollama / NIM)
# "anthropic" → Claude via the official Anthropic SDK (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=local

# Local inference (GB10 / DGX Spark). Ollama default shown; vLLM uses :8000/v1.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:32b
LLM_API_KEY=not-needed
LLM_MAX_TOKENS=8192
# Long-output calls (section drafting, SAP, audit). Reasoning models spend output tokens on
# thinking first; the client retries with a doubled budget up to LLM_MAX_TOKENS_CAP on truncation.
LLM_SECTION_MAX_TOKENS=12000
LLM_MAX_TOKENS_CAP=24000
LLM_TIMEOUT_SECONDS=3600
# Extra JSON merged into every chat request. Recommended for Qwen3 on Ollama ≥ 0.40 (turns thinking off,
# roughly halves generation time):   LLM_EXTRA_BODY={"reasoning_effort":"none"}
# vLLM equivalent:                    LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY=

# Anthropic (only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Embeddings for the regulatory RAG (OpenAI-compatible /v1/embeddings) ─────
EMBEDDINGS_BASE_URL=http://ollama:11434/v1
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_DIM=1024

# ── Storage ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://copilot:copilot@postgres:5432/copilot
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=regulatory_guidance

# ── MCP servers (streamable HTTP endpoints as seen from the backend) ─────────
MCP_BIOSTAT_URL=http://mcp-biostat-calc:8101/mcp
MCP_CLINICALTRIALS_URL=http://mcp-clinicaltrials:8102/mcp
MCP_OPENFDA_URL=http://mcp-openfda-predicate:8103/mcp
MCP_PUBMED_URL=http://mcp-pubmed-evidence:8104/mcp
MCP_REGULATORY_RAG_URL=http://mcp-regulatory-rag:8105/mcp

# ── External API keys (optional but recommended) ─────────────────────────────
# NCBI E-utilities: 3 req/s without key, 10 req/s with key.
NCBI_API_KEY=
NCBI_TOOL=ai-samd-protocol-copilot
NCBI_EMAIL=
# openFDA: 240 req/min with key vs 40 without.
OPENFDA_API_KEY=

# ── Security ─────────────────────────────────────────────────────────────────
# Shared secret between the frontend proxy and the backend. Generate: openssl rand -hex 32
# Empty = no authentication (only acceptable on a single-user machine that is not on a shared network).
API_KEY=
# Host interfaces the published ports bind to. Backend / Qdrant / Ollama default to loopback;
# only the frontend (3000) is exposed on the LAN.
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=0.0.0.0
# Host ports (change instead of editing docker-compose.yml when a port is taken)
FRONTEND_PORT=3000
BACKEND_PORT=8000
QDRANT_PORT=6333
OLLAMA_PORT=11434
VLLM_PORT=8001

# ── Frontend ─────────────────────────────────────────────────────────────────
# Leave empty: browser → same-origin /backend → Next.js server proxy → backend (API key injected
# server-side, never shipped to the browser). Only set for a split deployment with its own auth.
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=http://localhost:3000

# ── Postgres container ───────────────────────────────────────────────────────
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
