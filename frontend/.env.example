# Leave empty (recommended): the browser calls same-origin /backend, which the Next.js server proxies to
# BACKEND_INTERNAL_URL and signs with BACKEND_API_KEY (server-side only, never sent to the browser).
NEXT_PUBLIC_API_BASE_URL=
# Server-side only (runtime env, not baked into the bundle)
BACKEND_INTERNAL_URL=http://localhost:8000
BACKEND_API_KEY=
